# Dev: via Nginx reverse proxy on localhost (no port needed)
# Prod: set to your API domain (e.g., https://api.example.com/api/v1)
VITE_API_URL=/api/v1

# Sentry error monitoring (Issue #58) — opt-in.
# Leave VITE_SENTRY_DSN empty to disable (app runs identically, nothing sent).
# In production set it to the DSN from your Sentry/GlitchTip frontend project.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
