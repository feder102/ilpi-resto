# Copy to ".env" on the server and fill in real values:
#   cp .env.prod.example .env

# Domain whose A record points to your Hetzner VPS public IPv4 (and AAAA for IPv6).
DOMAIN=ilpi.tudominio.com

# PostgreSQL credentials (the DB runs in a container; not exposed to the host).
POSTGRES_USER=ilpi
POSTGRES_PASSWORD=cambia-esto-por-una-password-fuerte
POSTGRES_DB=ilpi

# Backend JWT secret. Must be >=32 chars. Generate one with:
#   openssl rand -hex 32
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres
