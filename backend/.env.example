DATABASE_URL=postgresql://ilpi:ilpi_dev_password@localhost:5432/ilpi
SECRET_KEY=change-this-to-a-random-string-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Email Configuration (SMTP)
# Development: Uses MailHog (http://localhost:8025 to view emails)
# Production: Configure with Gmail SMTP, SendGrid, AWS SES, etc.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ilpi.local

# Frontend URL for email links (password reset, etc.)
APP_URL=http://localhost:5173
