DATABASE_URL=postgresql://ilpi:ilpi_dev_password@localhost:5432/ilpi
SECRET_KEY=change-this-to-a-random-string-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Email Configuration (Mailjet)
# Production: Set MAILJET_API_KEY to use Mailjet HTTP API (mailjet.com)
# Development: Leave MAILJET_API_KEY empty to use MailHog SMTP (http://localhost:8025)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_NAME=ILPI
MAILJET_SENDER_EMAIL=tu-email@gmail.com

# SMTP fallback for local development (MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025

# Sentry error monitoring (Issue #58) — opt-in.
# Leave SENTRY_DSN empty to disable (app runs identically, no data sent).
# In production set it to the DSN from your Sentry/GlitchTip project.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
