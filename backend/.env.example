DATABASE_URL=postgresql://ilpi:ilpi_dev_password@localhost:5432/ilpi
SECRET_KEY=change-this-to-a-random-string-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Email Configuration
# Production: Set RESEND_API_KEY to use Resend HTTP API (resend.com)
# Development: Leave RESEND_API_KEY empty to use MailHog SMTP (http://localhost:8025)
RESEND_API_KEY=
RESEND_FROM=ILPI <onboarding@resend.dev>

# SMTP fallback for local development (MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025

# Frontend URL for email links (password reset, etc.)
APP_URL=http://localhost:5173
